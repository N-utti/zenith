!.env.example
*.sqlite3

# Node / React
node_modules/
dist/
dist-ssr/
.vite/
*.local
.turbo/

# Tauri / Capacitor
**/src-tauri/target/
# Tauri가 빌드 때 다시 만든다 (권한 스키마·모바일 프로젝트).
**/src-tauri/gen/schemas/
# 모바일은 Capacitor로 간다. `tauri icon`이 곁다리로 만드는 Tauri-모바일용
# 아이콘 세트는 쓰지 않으므로 추적하지 않는다 (재생성해도 diff가 나지 않게).
**/src-tauri/icons/android/
**/src-tauri/icons/ios/
apps/**/android/app/build/
apps/**/ios/App/build/
*.apk
*.msi
*.ipa

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Data / models / uploads (온프레미스, 절대 커밋 금지)
data/
models/
minio-data/
infra/backups/
*.gguf

# 에이전트 로컬 상태
.gstack/
.omc/

# Claude Code 개인 설정(권한 허용 목록 등) — 공용 하네스는 .claude/settings.json 에 커밋한다
.claude/settings.local.json
# Tailscale/사내 CA 인증서 (infra/README "TLS")
infra/certs/
# 외부 호스팅(infra/hosted) — 회사별 비밀값·사이트 블록·공통 api 설정·덤프
# (디렉터리는 .gitkeep 으로 둔다 — 없으면 docker 가 root 소유로 만들어 tenant.sh 가 못 쓴다)
infra/hosted/tenants/*
infra/hosted/sites/*
!infra/hosted/*/.gitkeep
infra/hosted/api.env
infra/hosted/backups/
