# 제니스 리버스 프록시 · TLS · 정적 파일 (ARCHITECTURE §7). compose 가 이 파일을 /etc/caddy/Caddyfile 로 마운트한다.
# 사이트 주소는 ZENITH_SITE (기본 localhost). 바꾸면 `docker compose restart caddy`.
{$ZENITH_SITE:localhost} {
	# ZENITH_TLS 가 비면 `internal`(Caddy 자체 CA — 루트는 caddy_data 의 caddy/pki/authorities/local/root.crt,
	# 사내 PC·앱의 신뢰 저장소에 배포). Tailscale(이슈 #265)이면 `tailscale cert` 로 받은 파일을 ./certs 에 두고
	# `ZENITH_TLS=/certs/cert.pem /certs/key.pem`. 사내 CA 인증서도 같은 모양.
	tls {$ZENITH_TLS:internal}
	encode zstd gzip

	header {
		# 첨부 내려받기가 같은 오리진이다 — 브라우저가 형식을 추측하지 않게. 프레임 삽입(클릭재킹)은 막는다.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# HSTS 는 아직 없다 — 사내 CA 결정 뒤(인증서가 깨지면 우회가 막힌다). 질문지는 infra/README "TLS".
		# CSP 는 2026-09-18 에 **Report-Only 를 뗐다**(이슈 #105). 프론트가 인라인 테마 스크립트를 /theme.js 로
		# 뺐고(프론트 PR #119), 빌드 산출물에 인라인 script·eval·외부 오리진 fetch·워커가 없음을 확인한 뒤다 —
		# 그래서 script-src 의 sha256 도 같이 뺐다(이제 가리키는 스크립트가 없다. 남겨 두면 다음 사람이 맞추려 든다).
		# 되돌리기는 헤더 이름에 -Report-Only 를 붙이는 한 줄.
		# 규칙의 근거: 프론트는 외부 리소스가 없다(CDN 금지, 루트 CLAUDE.md). style 'unsafe-inline' 은 React style={}
		# 속성과 ProseMirror 가 넣는 <style> 때문. img data: 는 Checkbox 의 svg 배경. connect 'self' 가 같은 오리진
		# wss(/api/ws·/api/yjs)와 SSE(/api/ai/chat)를 덮는다. font·worker 는 default 'self' 로 충분(외부 폰트·워커 없음).
		# xlsx 내려받기는 blob: URL 을 a[download] 로 클릭한다 — 다운로드라 fetch 지시어를 타지 않는다.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# /api/metrics 는 인증이 없다 — 스크레이퍼는 compose 안에서 api:8000 을 직접 긁고, 바깥에는 없는 경로다.
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		# FastAPI 는 인증 전에 multipart 를 다 받아 둔다 — backend/app/main.py 의 body_limit 는 Content-Length 만
		# 보므로 chunked 전송은 여기서 자른다(같은 값 12MiB = 첨부 10MB + 봉투). 초과는 caddy 의 413 평문이다.
		request_body {
			max_size 12MiB
		}
		# WebSocket(/api/ws · /api/yjs) 업그레이드는 reverse_proxy 가 알아서 한다. Host 는 바꾸지 않는다.
		# api 의 CSRF·WS Origin 대조가 X-Forwarded-Proto/Host 를 믿는다(backend/app/deps.py _own_origin) — caddy 2.7+ 는
		# 미신뢰 피어가 보낸 X-Forwarded-* 를 버리지만, 버전·trusted_proxies 설정과 무관하게 caddy 가 본 Host 로 못박는다.
		reverse_proxy api:8000 {
			header_up X-Forwarded-Host {host}
		}
	}

	# Vite 산출물. /assets/* 는 해시 파일명이라 영구 캐시, 그 외(index.html 과 SPA 폴백)는 매번 확인 — 새 빌드가 바로 보이게.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
