<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="kr.zenith.app">
  <uses-permission android:name="android.permission.INTERNET" />
  <application
      android:label="제니스"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/Zenith"
      android:usesCleartextTraffic="false"
      android:allowBackup="false">
    <!-- 백업을 끈다. 켜 두면 로그인 쿠키(갱신 토큰)가 든 웹 화면 저장소가 구글 백업에 실린다. -->
    <!-- 다크 모드 전환(uiMode)은 일부러 받지 않는다. 화면을 다시 만들어야 상단 막대 색과
         웹 화면의 prefers-color-scheme 이 새 모드를 따른다. -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
