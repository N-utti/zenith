# backend/.env 로 복사해 쓴다. .env* 는 커밋되지 않는다 (.gitignore).

# ── 저장소 (ARCHITECTURE §7) ─────────────────────────────────────
# localhost 가 아니라 127.0.0.1 로 적는다. compose 가 127.0.0.1 에만 바인딩하는데 Windows 는 localhost 를 ::1 부터
# 시도해, 새 연결마다 2초를 기다린 뒤에야 IPv4 로 넘어간다(2026-09-21 측정: DB 2050ms → 30ms, MinIO 2060ms → 3ms).
DATABASE_URL=postgresql+asyncpg://zenith:zenith@127.0.0.1:5432/zenith
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=zenith
MINIO_SECRET_KEY=zenith-minio
MINIO_BUCKET=zenith

# ── 인증 (04-API §1 · 11 §7.2) ───────────────────────────────────
# 필수 · 32바이트 이상 · 기본값 없음(비어 있으면 서버가 뜨지 않는다). 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 로컬 http 개발에서만 false. 운영(HTTPS)은 true.
COOKIE_SECURE=false

# ── AI (Claude API — 2026-09-04 결정, backend/README "설계와 어긋나는 것" 참조) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=64000
# 벡터 검색(README 45) — Ollama /api/embed. 비우면 꺼짐(핵심어 검색만). compose 안에서는 http://ollama:11434
EMBED_URL=
EMBED_MODEL=bge-m3:567m

# ── 네이티브 셸(Tauri/Capacitor)이 다른 오리진에서 붙을 때만 (JSON 배열) ──
# CORS_ORIGINS=["tauri://localhost","http://tauri.localhost"]
