# 이 파일을 .env.local (개발) 또는 .env.production (배포 빌드) 으로 복사해 쓴다.
# .env* 는 커밋되지 않는다 (.gitignore).

# MSW 목을 끄고 vite 프록시를 통해 실제 FastAPI(:8000)에 붙는다.
# VITE_DISABLE_MSW=true
# 8000 이 다른 프로세스에 잡혀 있을 때 프록시 대상. (vite.config.ts 가 읽는다)
# VITE_API_TARGET=http://localhost:8010

# 앱이 붙을 사내 서버 오리진. 비워 두면 같은 오리진으로 나간다(브라우저 기본값).
#
# 데스크탑 셸(apps/desktop) 배포 빌드에서는 반드시 채워야 한다: 셸 화면은
# tauri://localhost 에서 뜨므로, 비워 두면 /api 요청이 사내 서버가 아니라
# 셸 자신에게 간다.
# VITE_SERVER_ORIGIN=https://zenith.example.co.kr
